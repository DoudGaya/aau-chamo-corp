# Public company information
NEXT_PUBLIC_SITE_URL=https://www.aauchamo.com
NEXT_PUBLIC_CONTACT_EMAIL=aauchamo@gmail.com
NEXT_PUBLIC_CONTACT_PHONE=+2349168340588
NEXT_PUBLIC_CONTACT_ADDRESS=Head office address, Kano, Nigeria
NEXT_PUBLIC_BUSINESS_HOURS=Monday - Saturday, 08:00 - 18:00 WAT
NEXT_PUBLIC_WHATSAPP_NUMBER=2349168340588
NEXT_PUBLIC_MAP_EMBED_URL=

# PostgreSQL enquiry storage
DATABASE_URL="postgresql://user:password@localhost:5432/aauchamo_corporate?schema=public"

# Transactional email (Resend)
RESEND_API_KEY="re_..."
ENQUIRY_FROM_EMAIL="A.A.U Chamo <enquiries@aauchamo.com>"
GENERAL_ENQUIRY_EMAIL="aauchamo@gmail.com"
CARGO_ENQUIRY_EMAIL="aauchamo@gmail.com"
TRAVEL_ENQUIRY_EMAIL="aauchamo@gmail.com"
UMRAH_ENQUIRY_EMAIL="aauchamo@gmail.com"

# Existing ERP / inventory tracking integration (optional — tracking shows enquiry status without this)
INVENTORY_TRACKING_API_URL="https://erp.aauchamo.com/api/tracking"
INVENTORY_API_TOKEN="erp_api_token_here"

# AI assistant (optional — falls back to local knowledge without this)
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"
# Soft monthly spend cap in USD (0 = unlimited). Set a hard limit in the OpenAI dashboard too.
OPENAI_MONTHLY_BUDGET_USD=20

# Admin API (required — used to authenticate GET /api/admin/enquiries and PATCH status)
ADMIN_API_SECRET="generate-a-long-random-secret-here"

# Google Analytics GA4 (optional — analytics disabled without this)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console verification token (optional)
GOOGLE_SITE_VERIFICATION=

# Sanity CMS (optional — static fallback content used without this)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_WEBHOOK_SECRET=

# Social links (optional)
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=

